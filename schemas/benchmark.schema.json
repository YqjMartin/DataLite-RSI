{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haolpku/DataLite-RSI/schemas/benchmark.schema.json",
  "title": "DataLite-RSI benchmark manifest",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "track",
    "description",
    "task_types",
    "dataset",
    "evaluator",
    "metrics",
    "license"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "track": {
      "enum": [
        "llm",
        "multimodal",
        "generative"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "task_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "dataset": {
      "type": "object",
      "required": [
        "registry_id",
        "revision"
      ],
      "properties": {
        "registry_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "evaluator": {
      "type": "object",
      "required": [
        "entrypoint"
      ],
      "properties": {
        "entrypoint": {
          "type": "string"
        },
        "container_image": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "higher_is_better"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "higher_is_better": {
            "type": "boolean"
          },
          "range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "license": {
      "type": "string"
    }
  }
}
